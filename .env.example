# ============================================================================
# ALERT SYSTEM CONFIGURATION
# ============================================================================

# ==============================
# --- Database Configuration ---
# ==============================
# (Handled by db_utils)

# SSH Tunnel into ubuntu
USE_SSH_TUNNEL=True
SSH_HOST=ssh_tunnel_host
SSH_PORT=22
SSH_USER=tunnel_username
SSH_KEY_PATH=/app/ssh_ubuntu_key
#SSH_KEY_PATH=/path_to/.ssh/datalab_prominence_prod.pem

# Database
DB_HOST=host_name
DB_PORT=5432
DB_NAME=db_name
DB_USER=db_username
DB_PASS=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ================================
# --- SMTP Email Configuration ---
# ================================
SMTP_HOST=smtp_host
SMTP_PORT=25
SMTP_USER=smtp_user@email.com
SMTP_PASS=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# ============================================================================
# RUNTIME MODE CONFIGURATION
# ============================================================================
DRY_RUN=True
DRY_RUN_EMAIL=dry_run_user@email.com
RUN_ONCE=False

# ========================
# --- Email Recipients ---
# ========================
# Internal recipients (always get notifications)
INTERNAL_RECIPIENTS=internal@email.com

# Company-specific TO recipients (applied based on vessel email domain)
PROMINENCE_EMAIL_TO_RECIPIENTS=ict@email.com
SEATRADERS_EMAIL_TO_RECIPIENTS=ict@other_email.com

# Company-specific CC recipients (applied based on vessel email domain)
PROMINENCE_EMAIL_CC_RECIPIENTS=safety@email.com
SEATRADERS_EMAIL_CC_RECIPIENTS=safety@other_email.com

# =====================
# --- Feature Flags ---
# =====================
ENABLE_EMAIL_ALERTS=True
ENABLE_TEAMS_ALERTS=False
ENABLE_SPECIAL_TEAMS_EMAIL_ALERT=False
SPECIAL_TEAMS_EMAIL=

# ========================
# --- Company Branding ---
# ========================
PROMINENCE_LOGO=logo_prominence.png
SEATRADERS_LOGO=logo_seatraders.png

# ============================================================================
# Document Links configuration
# ============================================================================

# Make column names clickable links (to event_id) 
ENABLE_LINKS=False
BASE_URL=https://base_url.com
# URL path pattern (without the ID), will append /{event_id} automatically
URL_PATH=

# ==================
# --- Scheduling ---
# ==================
SCHEDULE_FREQUENCY_HOURS=
SCHEDULE_TIMES=08:00
#12:00,18:00
SCHEDULE_TIMES_TIMEZONE=Europe/Athens
TIMEZONE=UTC

# ============================
# --- Tracking & Reminders ---
# ============================
REMINDER_FREQUENCY_DAYS=
SENT_EVENTS_FILE=sent_alerts.json


# Alert-Specific Configuration (check last 24 hours)
MASTER_CHANGE_DAYS=14
LOOKBACK_DAYS=40
RANK_ID=1
ENABLE_LINKS=False

# ===============
# --- Logging ---
# ===============
LOG_FILE=alerts.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5


# ----------------------------------
# --------- User permissions -------
# ----------------------------------
# echo UID=$(id -u) and echo GID=$(id -g)
UID=1000
GID=1000
